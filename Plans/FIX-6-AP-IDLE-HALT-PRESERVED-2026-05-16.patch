+/// Atomically enable interrupts and halt the CPU (`sti; hlt`).
+///
+/// Any interrupt that arrived while IF=0 is pending in the LAPIC and fires
+/// immediately on `sti`, so this sequence cannot sleep through a wake signal.
+/// Interrupts are enabled on return. The IDT and LAPIC must be fully initialized
+/// before this is called — only valid for APs in their idle bootstrap loop.
+#[inline(always)]
+pub fn enable_and_hlt() {
+    interrupts::enable_and_hlt();
+}
+
 /// Return whether the local CPU's interrupt flag is currently set.
