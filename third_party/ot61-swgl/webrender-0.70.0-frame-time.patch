+/// The time a `FrameStamp` records. Nothing in WebRender reads it back
+/// (`FrameStamp::time` has no caller); it only has to differ from
+/// `UNIX_EPOCH` for the `is_valid` debug check.
+#[cfg(not(target_os = "neoplutarch"))]
+fn frame_time() -> SystemTime {
+    SystemTime::now()
+}
+
+/// LogansOS patch (OT-61 rung 4 S2): the browser bundle has no wall clock, and
+/// std's `SystemTime::now` aborts there rather than invent one. Record
+/// `UNIX_EPOCH` plus the monotonic time since the first frame (plus 1 ns, so it
+/// is never `UNIX_EPOCH` itself); see the comment above for why that's enough.
+#[cfg(target_os = "neoplutarch")]
+fn frame_time() -> SystemTime {
+    use std::sync::OnceLock;
+    use std::time::{Duration, Instant};
+    static START: OnceLock<Instant> = OnceLock::new();
+    let since = START.get_or_init(Instant::now).elapsed();
+    UNIX_EPOCH + since + Duration::from_nanos(1)
+}
