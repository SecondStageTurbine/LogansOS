diff --git a/mozjs-sys/mozjs/build/moz.configure/init.configure b/mozjs-sys/mozjs/build/moz.configure/init.configure
index 63049b6..1e960b6 100644
--- a/mozjs-sys/mozjs/build/moz.configure/init.configure
+++ b/mozjs-sys/mozjs/build/moz.configure/init.configure
@@ -529,6 +529,11 @@ def split_triplet(triplet, allow_wasi=False):
         canonical_os = canonical_kernel = "SunOS"
     elif os.startswith("wasi") and allow_wasi:
         canonical_os = canonical_kernel = "WASI"
+    elif os == "neoplutarch" and allow_wasi:
+        # LogansOS (OT-61 C3c-1, trap T6). Standalone JS only, like WASI. The
+        # compiler is clang for x86_64-unknown-none-elf over neo-crt's headers,
+        # and it predefines __neoplutarch__ (the generator's CC wrapper).
+        canonical_os = canonical_kernel = "NeoPlutarch"
     else:
         raise ValueError("Unknown OS: %s" % os)
 
@@ -647,6 +652,9 @@ def config_sub(shell, triplet):
         "-windows-gnu": "-mingw32",
         "-ios-sim": "-ios",
     }
+    # config.sub doesn't know LogansOS; split_triplet does (patch 0002).
+    if triplet.endswith("-neoplutarch"):
+        return triplet
     for check_suffix, replacement in munging.items():
         if triplet.endswith(check_suffix):
             suffix = check_suffix
diff --git a/mozjs-sys/mozjs/build/moz.configure/toolchain.configure b/mozjs-sys/mozjs/build/moz.configure/toolchain.configure
index dff149b..09caeb5 100755
--- a/mozjs-sys/mozjs/build/moz.configure/toolchain.configure
+++ b/mozjs-sys/mozjs/build/moz.configure/toolchain.configure
@@ -2260,6 +2260,11 @@ def check_thread(target, c_compiler):
     if target.os == "Android":
         # The custom dynamic linker doesn't support TLS variables
         return False
+    if target.kernel == "NeoPlutarch":
+        # LogansOS (patch 0002): __thread compiles, and links, to %fs
+        # accesses that this target doesn't set up for C/C++ (neo-crt, C3b).
+        # MOZ_THREAD_LOCAL must take its pthread-key path.
+        return False
     return c_compiler.type != "clang-cl"
 
 
