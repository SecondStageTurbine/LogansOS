@@ -43,6 +43,7 @@ class OS(EnumString):
         "SunOS",
         "WINNT",
         "WASI",
+        "NeoPlutarch",
     )
 
 
@@ -58,6 +59,7 @@ class Kernel(EnumString):
         "SunOS",
         "WINNT",
         "WASI",
