// OT-61 C3c-1: <ostream> for the SpiderMonkey build only (generator/neo-cc
// puts this directory ahead of libc++'s).
//
// neo-crt's libc++ is configured without localization (C3a,
// userland/neo-crt/cxx/__config_site), so its <ostream> is an error.
// SpiderMonkey's headers (Maybe.h, Array.h, TimeStamp.h, RegExpFlags.h, ...)
// include <ostream> to declare operator<< templates for debug printing, which
// the engine never instantiates. libc++'s <iosfwd> declares std::ostream,
// and that is all those declarations need. Code that really writes to a
// stream still fails to compile here; patch 0003 guards it.
#ifndef NEO_MOZJS_OSTREAM_SHIM
#define NEO_MOZJS_OSTREAM_SHIM
#include <iosfwd>
#endif
