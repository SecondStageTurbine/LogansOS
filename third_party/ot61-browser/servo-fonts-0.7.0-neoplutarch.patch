diff -ruN -I SPDX-License-Identifier -x .cargo-checksum.json -x .cargo-ok vendor/servo-fonts-0.7.0/platform/neoplutarch/font.rs patched/servo-fonts-0.7.0/platform/neoplutarch/font.rs
