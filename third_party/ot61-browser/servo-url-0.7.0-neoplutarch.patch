     pub fn to_file_path(&self) -> Result<::std::path::PathBuf, UrlError> {
+        // LogansOS: `url` has no file paths on target_os = "neoplutarch", and
+        // a content process has no ambient file system to name.
+        #[cfg(target_os = "neoplutarch")]
+        return Err(UrlError::ToFilePath);
+        #[cfg(not(target_os = "neoplutarch"))]
         self.0.to_file_path().map_err(|_| UrlError::ToFilePath)
