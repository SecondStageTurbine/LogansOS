# SPDX-License-Identifier: CC-BY-4.0
# Independent ABI oracle (ADR-077 v2 §1 / amendment 6) for the separable-blur
# cross-thread payload table in README.md. zebin .ze_info for the stateless-A64
# separable_blur, emitted by `ocloc disasm` (igc-1.0.17193.4 / CR 24.26.30049.6).
# payload_arguments give the byte offsets/sizes of src/dst/weights (stateless A64
# pointers) + width/height/stride/radius/axis (byvalue u32) the driver fills;
# has_4gb_buffers = true confirms stateless; NO slm_size / NO barrier_count keys
# => SLM=0, barriers=0 (ADR-077 v2 §4.5). SIMD32, 3-GRF cross-thread (span [0,88)),
# 6-GRF per-thread local_id (SIMD32, 2-D: local_id.x r1/r2 + local_id.y r3/r4).
---
version:         '1.43'
kernels:
  - name:            separable_blur
    user_attributes:
      intel_reqd_workgroup_walk_order: [ 0, 1, 2 ]
    execution_env:
      grf_count:       128
      has_4gb_buffers: true
      simd_size:       32
      subgroup_independent_forward_progress: true
      work_group_walk_order_dimensions: [ 0, 1, 2 ]
      eu_thread_count: 7
    payload_arguments:
      - arg_type:        global_id_offset
        offset:          0
        size:            12
      - arg_type:        local_size
        offset:          12
        size:            12
      - arg_type:        arg_bypointer
        offset:          0
        size:            0
        arg_index:       0
        addrmode:        stateful
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_bypointer
        offset:          32
        size:            8
        arg_index:       0
        addrmode:        stateless
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_bypointer
        offset:          0
        size:            0
        arg_index:       1
        addrmode:        stateful
        addrspace:       global
        access_type:     readwrite
      - arg_type:        arg_bypointer
        offset:          40
        size:            8
        arg_index:       1
        addrmode:        stateless
        addrspace:       global
        access_type:     readwrite
      - arg_type:        arg_bypointer
        offset:          0
        size:            0
        arg_index:       2
        addrmode:        stateful
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_bypointer
        offset:          48
        size:            8
        arg_index:       2
        addrmode:        stateless
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_byvalue
        offset:          56
        size:            4
        arg_index:       3
      - arg_type:        arg_byvalue
        offset:          60
        size:            4
        arg_index:       4
      - arg_type:        arg_byvalue
        offset:          64
        size:            4
        arg_index:       5
      - arg_type:        arg_byvalue
        offset:          68
        size:            4
        arg_index:       6
      - arg_type:        arg_byvalue
        offset:          72
        size:            4
        arg_index:       7
      - arg_type:        enqueued_local_size
        offset:          76
        size:            12
    per_thread_payload_arguments:
      - arg_type:        local_id
        offset:          0
        size:            192
    binding_table_indices:
      - bti_value:       0
        arg_index:       0
      - bti_value:       1
        arg_index:       1
      - bti_value:       2
        arg_index:       2
kernels_misc_info:
  - name:            separable_blur
    args_info:
      - index:           0
        name:            src
        address_qualifier: __global
        access_qualifier: NONE
        type_name:       'uchar*;8'
        type_qualifiers: const
      - index:           1
        name:            dst
        address_qualifier: __global
        access_qualifier: NONE
        type_name:       'uchar*;8'
        type_qualifiers: NONE
      - index:           2
        name:            weights
        address_qualifier: __global
        access_qualifier: NONE
        type_name:       'int*;8'
        type_qualifiers: const
      - index:           3
        name:            width
        address_qualifier: __private
        access_qualifier: NONE
        type_name:       'uint;4'
        type_qualifiers: NONE
      - index:           4
        name:            height
        address_qualifier: __private
        access_qualifier: NONE
        type_name:       'uint;4'
        type_qualifiers: NONE
      - index:           5
        name:            stride
        address_qualifier: __private
        access_qualifier: NONE
        type_name:       'uint;4'
        type_qualifiers: NONE
      - index:           6
        name:            radius
        address_qualifier: __private
        access_qualifier: NONE
        type_name:       'uint;4'
        type_qualifiers: NONE
      - index:           7
        name:            axis
        address_qualifier: __private
        access_qualifier: NONE
        type_name:       'uint;4'
        type_qualifiers: NONE
...
